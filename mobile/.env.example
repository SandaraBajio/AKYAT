# Copy to .env and fill in. Variables starting with EXPO_PUBLIC_ are bundled into the app.
# Leave EXPO_PUBLIC_FIREBASE_API_KEY empty to run in MOCK MODE (no Firebase needed, great for UI work).

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Set to true to force mock mode even when Firebase keys are filled in.
EXPO_PUBLIC_USE_MOCK=false

# Talk to the local Firebase emulators (npm run serve in /functions) instead of the cloud.
EXPO_PUBLIC_USE_EMULATOR=false
# Android emulator: 10.0.2.2   iOS simulator / web: localhost   Real phone: your laptop's LAN IP
EXPO_PUBLIC_EMULATOR_HOST=10.0.2.2
